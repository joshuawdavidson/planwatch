$send_sig=array(array($xmlrpcString,$xmlrpcString,$xmlrpcString));

$send_doc='receives planworld sends';

function send_receive($m) {
	global $xmlrpcerruser;
	include_once('snoop.php');
	$err="";
	// get the param values (should add integrity checking here)
	$lu=$m->getParam(0);
	$ru=$m->getParam(1);
	$msg=$m->getParam(2);

	$localuser=$lu->scalarval();
	$remoteuser=$ru->scalarval();
	$message=$msg->scalarval();

	include_once('send.php');
	$success=send_addmessage($localuser,$remoteuser,$message);

	// if we generated an error, create an error return response
	if ($err) {
	return new xmlrpcresp(0, $xmlrpcerruser, $err);
	} else {
	// otherwise, we create the right response
	// with the state name
	header("http/1.1 200 ok");
	return new xmlrpcresp(new xmlrpcval($success,'boolean'));
	}
}

