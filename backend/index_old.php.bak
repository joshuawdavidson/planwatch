// an xml-rpc interface to plan_read()
//
// josh@planwatch.org
// based on the planworld xml-rpc API authored by snfitzsimmon@note.amherst.edu

$plan_gettext_sig=array(array($xmlrpcString, $xmlrpcString, $xmlrpcString, $xmlrpcBoolean),array($xmlrpcString, $xmlrpcString, $xmlrpcString, $xmlrpcBoolean, $xmlrpcString));

$plan_gettext_doc='when passed a planwatch.org username in $localuser, along with a remote username
in $remoteuser and a snitch value in the bool $snitch, a base64 response containing the plan of
$localuser will be returned.';

function plan_gettext($m) {
	global $xmlrpcerruser;
	include_once('plan_read.php');
	$err="";
	// get the param values (should add integrity checking here)
	$lu=$m->getParam(0);
	$ru=$m->getParam(1);
	$sn=$m->getParam(2);
	if ($m->getParam(3)) $ar=$m->getParam(3);

	$localuser=$lu->scalarval();
	$localuser=str_replace("@planwatch.org",'',$localuser);
	if (strpos(':',$localuser))
		list($localuser,$archivestring)=explode(':',$localuser);
	$remoteuser=$ru->scalarval();
	$snitch=$sn->scalarval();
	if (is_object($ar)) $archivestring=$ar->scalarval();
	
	$localuser=str_replace("@planwatch.org",'',$localuser);
	$planinfo=unserialize(file_get_contents("$_SERVER[FILE_ROOT]/pwusers/$localuser/userinfo.dat"));
	putenv('DEFAULTDAYS='.$planinfo['defaultdays']);

	putenv("REMOTESNITCH=$snitch");

	if ($archivestring=='archives')
	{
		$plan='Not Implemented Yet. Stay Tuned.';
	}
	elseif(strstr($archivestring,'/'))
	{
		$archive_date_array=explode('/',$archivestring);
		$begindate=mktime($hours=str_replace(array('%3A00',':00'),'',$archive_date_array[4]),0,0,$archive_date_array[2],$archive_date_array[3],$archive_date_array[1]);
		$threshhold=$archive_date_array[0];
	}
	elseif($archivestring=='' || !isset($archivestring))
	{
		$threshhold='2d';
		$begindate=FALSE;
	}

	if (!$plan)
	{
		$plan=plan_read($localuser,$threshhold,$remoteuser,$snitch,$begindate);
	    $plan=plan_add_alias_links($plan,$localuser,TRUE);
	}

	// if we generated an error, create an error return response
	if ($err) {
	return new xmlrpcresp(0, $xmlrpcerruser, $err);
	} else {
	// otherwise, we create the right response
	// with the state name
	return new xmlrpcresp(new xmlrpcval($plan,'base64'));
	}
}

$planworld_whois_sig_a=array(array($xmlrpcString, $xmlrpcString));
$planworld_whois_sig_b=array(array($xmlrpcString));
$planworld_whois_sig=array($planworld_whois_sig_a,$planworld_whois_sig_b);

