<?php
/*
USERFILES.case

handles the file functions
*/

switch($urlarray[2]):

	case "view":
		$urlarray[4]=urldecode($urlarray[4]);
		$filename="$_SERVER[PWUSERS_DIR]/$urlarray[3]/files/$urlarray[4]";

		if(!file_exists($filename) && (strstr($filename,'.width.') || strstr($filename,'.square.')) && strstr($filename,'.jpg'))
		{
			include_once('plan_update.php');
			// header("http/1.1 200 ok");
			// header("Content-type: text/plain");

			if(stristr($filename,'.square.'))
			{
				$dimension = 'square';
				$filename_parts = explode(".square.",$filename);
				$original_filename = basename($filename_parts[0]);
				$size = str_replace(".jpg","",$filename_parts[1]);
			}
			if(stristr($filename,'.width.'))
			{
				$dimension = 'width';
				$filename_parts = explode(".width.",$filename);
				$original_filename = basename($filename_parts[0]);
				$size = str_replace(".jpg","",$filename_parts[1]);
			}

			photo_resize("$_SERVER[PWUSERS_DIR]/$urlarray[3]/files/$original_filename",$dimension,$size,'.jpg',"$_SERVER[PWUSERS_DIR]/$urlarray[3]/files");
			$filename="$_SERVER[PWUSERS_DIR]/$urlarray[3]/files/$original_filename.$dimension.$size.jpg";
			// echo "\n\n$filename";
			// exit;

		}

		$content_type=shell_exec("file -ib ".str_replace(" ","\\ ",$filename));

		if (strpos($content_type,'rtf'))
		{
			$output=`/usr/bin/unrtf '$filename'`;
			$content_type='text/html';
			Header("http/1.1 200 ok");
			echo $output;
			exit;
		}
		else
		{
			if (strstr($filename,'.mp3')) $content_type='audio/mpeg3';
			Header("http/1.1 200 ok");
			Header("Content-type: $content_type");
			readfile("$filename");
			exit;
		}


		break;

	case "list":
		include_once('userfiles.php');
		$_SERVER['OUTPUT_MODE']='AJAX';
		output("File List",userfiles_build_menu());
		break;

	case "delete":
		if (file_exists("$_SERVER[PWUSERS_DIR]/$urlarray[3]/files/$urlarray[4]"))
			unlink("$_SERVER[PWUSERS_DIR]/$urlarray[3]/files/$urlarray[4]");
		if ($urlarray[5]=='menu') redirect('/userfiles/list');
		else redirect("/userfiles/manage/$urlarray[3]");
		break;

	case "manage":
		include_once('userfiles.php');
		if (trim($urlarray[3])) $files_user=trim(urldecode($urlarray[3]));
		else $files_user=$_SERVER['USER'];
		$content=userfiles_manage($files_user);
		output("$urlarray[3] Managing Files",$content);
		break;

	default:
		include_once('userfiles.php');
		$files_lists=userfiles_prepare($urlarray[3]);
		output("$urlarray[3]'s Files",implode("<br />",$files_lists));
		break;

endswitch;


?>