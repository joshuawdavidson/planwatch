<?php

/*
SNITCH.case
displays snitch page
*/

	if(!isset($threshvalue))
	{
		$threshvalue='';
	}
	if(!isset($weeks_selected))
	{
		$weeks_selected='';
	}
	if(!isset($days_selected))
	{
		$days_selected='';
	}
	if(!isset($hours_selected))
	{
		$hours_selected='';
	}
	if(!isset($minutes_selected))
	{
		$minutes_selected='';
	}
	if(!isset($newest_first))
	{
		$newest_first='';
	}
	if(!isset($oldest_first))
	{
		$oldest_first='';
	}


	if (isset($_SERVER['USER']))
	{
		if (!isset($urlarray[2]) && $_SERVER['USERINFO_ARRAY']['snitch_default_days']) $urlarray[2]="r".$_SERVER['USERINFO_ARRAY']['snitch_default_days']."d";

		include_once('snitch.php');

		$snitch_list=snitch_read($_SERVER['USER'],$urlarray[2]);

		$content='';
		if ($_SERVER['OUTPUT_MODE']!='MOBILE')
		{
			$content="<h1>Snitch</h1>";
		}

		$topstuff="
				<aside id='topstuff' style='float: right;'>
				<span class='edit_links'>
					<img src='$_SERVER[WEB_ROOT]$GLOBALS[helpicon]' /> <br />
					<a href='$_SERVER[WEB_ROOT]/help/snitch'>snitch help</a> <br />
					<a href='$_SERVER[WEB_ROOT]/help/privacy'>what does 'block' do?</a>
					<br />
				</span>

				<br/><br/>

				<form action='$_SERVER[WEB_ROOT]/scripts/form_shim.php' method='post' class='archive_form'>
						history:
						<input type='text' name='threshhold' value='$threshvalue' size='3'/>
						<select name='units'>
							<option value='w' $weeks_selected>weeks</option>
							<option value='d' $days_selected>days</option>
							<option value='h' $hours_selected>hours</option>
							<option value='m' $minutes_selected>minutes</option>
						</select>
						<select name='reverse'>
							<option value='r' $newest_first>newest first</option>
							<option value='' $oldest_first>oldest first</option>
						</select>
						<input type='hidden' name='action' value='snitch_archive'/>
						<input type='submit' value='view'/>
				</form>
				</aside> <!-- /#topstuff -->
				\n";
			$snitch_list=str_replace("@amherst.edu "," <small>@amherst.edu</small> ",$snitch_list);
			$content.="<ul class='flicklist' style='float: left;' selected='true'>$snitch_list</ul>";
			$content.=$topstuff;

		if ($_SERVER['OUTPUT_MODE']=='MOBILE')
		{
			$content=str_replace("Anonymous Coward from ","AC: ",$content);

		}

		if (!$_SERVER['USERINFO_ARRAY']['showsnoop'] && $_SERVER['OUTPUT_MODE']!='MOBILE')
		{
			include_once('snoop.php');
			$content="<h1>snoop</h1><ul id='snoop' class='flicklist'><li><em>not an exact science</em></li>$snoop".snoop_list()."</ul>$content";
		}
		output("snitch: $_SERVER[USER]",$content);
	}
	else
	{
		$content="You're not logged in, so you can't view your snitch";
		output('error: no snitch',$content,''," has no snitch");
	}
?>