if (isset($urlarray[2]) && $urlarray[2]=='ajax')
{
	$ajax_content='';
	$_SERVER['OUTPUT_MODE']='AJAX';
	$snitch_tool_links="<div class='homebox'><a href='javascript:refresh(\"homesnitch\",\"/home/ajax/snitch\");'  class='tool'>&#x21bb;</a>  <a href='/snitch' class='tool'>&hellip;</a></div>";
	$snoop_tool_links="<div clqss='homebox'><a href='javascript:refresh(\"homesnoop\",\"/home/ajax/snoop\");'  class='tool'>&#x21bb;</a>  <a href='/snoop' class='tool'>&hellip;</a></div>";
	$send_tool_links="<div class='homebox'><a href='javascript:refresh(\"homesend\",\"/home/ajax/send\");'  class='tool'>&#x21bb;</a>  <a href='/send' class='tool'>&hellip;</a></div>";
	$spiel_tool_links="<div class='homebox'><a href='javascript:refresh(\"homespiel\",\"/home/ajax/spiel\");'  class='tool'>&#x21bb;</a>  <a href='/spiel' class='tool'>&hellip;</a></div>";

	switch($urlarray[3]):


	case "snitch":
		include_once('snitch.php');
		$snitch=snitch_read($_SERVER['USER'],"r2h");
		if ($snitch)
		{
			$ajax_content="<li class='listheader'>$snitch_tool_links snitch</li>$snitch<li><a href='/snitch'>more...</a></li>";
		}
		else
		{
			$ajax_content="<li class='listheader'>snitch <a href='javascript:refresh(\"homesnitch\",\"/home/ajax/snitch\");'>&#x293E;</a> <a href='/snitch'>...</a> </li><li>no readers in the past 2 hours</li><li><a href='/snitch'>more...</a></li>";
		}
		break;

	case "snoop":
		include_once('snoop.php');
		$snoop=snoop_list("homesnoop");
		if (strpos($snoop,'no snoops found')===FALSE)
		{
			$ajax_content="<li class='listheader'>$snoop_tool_links snoop</li>$snoop";
		}
		else
		{
			$ajax_content='';
		}
		break;

	case "send":
		include_once('send.php');
		$sends=send_list($onlynew="week");
		if ($sends)
		{
			$ajax_content="<li class='listheader'>$send_tool_links send</li>$sends<li><a href='/send'>more...</a></li>\n";
		}
		else
		{
			$ajax_content='';
		}
		break;

	case "spiel":
		include_once('spiel.php');
		$ajax_content="<li>".str_replace("\n","</li>\n<li>",spiel_format_list_html()."</li>");
		break;

	default: break;
	endswitch;

	$_SERVER['OUTPUT_MODE']='AJAX';
	output("home $urlarray[3]",$ajax_content); exit;
}

if (isset($urlarray[2]) && $urlarray[2]=='micro')
{
	if ($new_sends_list=files_list("$_SERVER[USER_ROOT]/sends/","*..new")) $new_sends_title=count($new_sends_list)." sends";

	$list_fn="$_SERVER[USER_ROOT]/watchedlist.txt";	// reads in the user's watched list
	if (file_exists($list_fn))
	{
		$list=file($list_fn);
	}
	$ptime=plan_get_last_update($list);
	$lastview=plan_get_last_view($list);

	foreach($list as $z=>$plan)
	{
		if ($ptime[$z] > $lastview[$z]) $new_plans_title+=1;
	}


	if ($new_plans_title) $new_plans_title.=" plans";
	if ($new_plans_title && $new_sends_title) $new_plans_title.=', ';
	header("Content-type: text/plain;");
	header("Expires: ".date("D, d M Y H:i:s",time()+60)." GMT");
	echo "[pwo] $new_plans_title $new_sends_title";
	exit;
}


