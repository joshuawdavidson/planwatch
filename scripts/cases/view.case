<?php
/*
cases/VIEW.php

allows views of lists of hidden and private entries
as well as specific files
*/

	switch($urlarray[2]):

	case "all_hidden":
		if(!isset($urlarray[3])) {$plan=$_SERVER['USER'];}
		else { $plan=$urlarray[3]; }
		if(plan_user_may_write($plan,$_SERVER['USER']))
		{
			exec("ls $_SERVER[PWUSERS_DIR]/$plan/plan/hidden*",$hiddenlist);
			$content="<h1>Hidden Plan Entries</h1>";
			if (!$hiddenlist[0]) $content.="<br />none available<br /><br /><br />";
			foreach($hiddenlist as $hiddenentry)
			{
				$hiddenentry=basename($hiddenentry);
				$he_array=explode('.',$hiddenentry);
				if(is_numeric($he_array[2]))
				{
					$he_time=date("jS F Y, h:ia",(int)$he_array[2]);
				}
				elseif(is_numeric($he_array[3]))
				{
					$he_time=date("jS F Y, h:ia",(int)$he_array[3]);
				}
				else
				{
					$he_time = $he_array[2];
				}

				$content.="<a href='$_SERVER[WEB_ROOT]/view/$plan/$hiddenentry'>$he_time</a><br />";
			}
			output("hidden entries",$content,'','viewing hidden entries');
		}
		else	output("no hidden entries","You don't have permission!",'','viewing hidden entries');
		break;

	case "all_private":
		if(!isset($urlarray[3])) {$plan=$_SERVER['USER'];}
		else { $plan=$urlarray[3]; }

		if(plan_user_may_write($plan,$_SERVER['USER']))
		{
			exec("ls $_SERVER[PWUSERS_DIR]/$plan/plan/*.p",$privatelist);
			$content="<h1>Private Plan Entries</h1>";
			if (!$privatelist[0]) $content.="<br />none available<br /><br /><br />";
			foreach($privatelist as $privateentry)
			{
				if (!strstr($privateentry,'rem'))
				{
					$privateentry=basename($privateentry);
					$pe_array=explode('.',$privateentry);
					$pe_time=date("jS F Y, h:ia",(int)$pe_array[1]);
					$content.="<hr><a href='$_SERVER[WEB_ROOT]/read/$plan/.$pe_array[1]'>$pe_time</a> \n [ <a href='$_SERVER[WEB_ROOT]/entry/publicize/$plan/.$pe_array[1]'>publicize</a> | <a href='$_SERVER[WEB_ROOT]/entry/hide/$plan/.$pe_array[1]'>hide</a> | <a href='$_SERVER[WEB_ROOT]/entry/delete/$plan/.$pe_array[1]'>delete</a> ]<hr>\n";
					$content.=substr(stripslashes(strip_tags(file_get_contents("$_SERVER[PWUSERS_DIR]/$plan/plan/$privateentry"))),0,512);
					// $content.="<hr/>\n";
				}
			}
			output("private entries",$content,'','viewing private entries');
		}
		else
		{
			output("no private entries","You don't have permission!",'','viewing private entries');
		}
		break;

	default:
		if(!isset($urlarray[2])) { redirect("/read/$_SERVER[USER]"); exit; }
		else { $plan=$urlarray[2]; }
		if(plan_user_may_write($plan,$_SERVER['USER']))
		{
			include_once('plan_read.php');
			$content="<b>entry from ".formattime(str_replace(array('.','plan','hidden','txt','p'),'',$urlarray[3]))."</b><hr>";
			$content.=smart_nl2br(plan_add_user_links(stripslashes(stripslashes(file_get_contents("$_SERVER[PWUSERS_DIR]/$plan/plan/$urlarray[3]")))));
			if (strstr($urlarray[3],'hidden'))
			{
				$he_array=explode('.',$urlarray[3]);
				$entrytc=".".$he_array[2];
				$content.="<hr>[ <a href='$_SERVER[WEB_ROOT]/entry/unhide/$plan/$entrytc'>unhide</a> | <a href='$_SERVER[WEB_ROOT]/entry/delete/$plan/$entrytc'>delete</a> ]";
			}
			if (strstr($urlarray[2],'txt.p'))
			{
				$he_array=explode('.',$urlarray[2]);
				$entrytc=".".$he_array[1];
				$content.="<hr>[ <a href='$_SERVER[WEB_ROOT]/entry/publicize/$plan/$entrytc'>publicize</a> | <a href='$_SERVER[WEB_ROOT]/entry/delete/$plan/$entrytc'>delete</a> ]";
			}
			output('entry from '.date("jS F Y, h:ia",$he_array[2]),$content,'','viewing a hidden entry');
		}
		else	output("no hidden entries","You don't have permission!",'','viewing hidden entries');
		break;

	endswitch;
?>
